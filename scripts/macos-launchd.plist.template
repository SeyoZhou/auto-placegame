<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cn.placegame.daily-automation</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__PROJECT__/placegame-auto.mjs</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT__/.placegame-logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/.placegame-logs/launchd.err.log</string>
</dict>
</plist>
